# Application Environment
APP_ENV=development

# Database Configuration
# For Docker: use DB_HOST=db
# For local development: use DB_HOST=127.0.0.1 and DB_PORT=3307 (if exposing Docker DB)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=starlightDB
DB_USERNAME=sd_admin
DB_PASSWORD=starlight
DB_CHARSET=utf8mb4

# MySQL Container Configuration (used by docker-compose.yml)
# These should be changed for production deployments
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=starlightDB
MYSQL_USER=sd_admin
MYSQL_PASSWORD=starlight

# Redis Configuration
# For Docker: use REDIS_HOST=redis
# For local development: use REDIS_HOST=127.0.0.1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Docker Port Configuration
# Uncomment and modify these to customize the external ports exposed by Docker containers
# These ports are used in docker-compose.yml for host-to-container port mapping
# DOCKER_APP_PORT=8080         # Web application port (access at http://localhost:8080)
# DOCKER_DB_PORT=3307          # Database port (for external DB clients like MySQL Workbench)
# DOCKER_REDIS_PORT=6379       # Redis port (for external Redis clients)

# Testing Database (optional)
# DB_DATABASE_TEST=starlightDB_test

# SPA/PWA feature flags
# Enable React notifications island on /notifications
FEATURE_SPA_NOTIFICATIONS=false
# Enable React glossary island on /glossary
FEATURE_SPA_GLOSSARY=false
# Enable React leaderboard island on /leaderboard
FEATURE_SPA_LEADERBOARD=false
# Enable React bank island on /bank
FEATURE_SPA_BANK=false
# Enable React training island on /training
FEATURE_SPA_TRAINING=false

# Metrics/log viewer auth (public/metrics-logs.php)
# Comma-separated user:password pairs
# Example: METRICS_LOGS_CREDENTIALS=admin:change-me,ops:change-me-too
# METRICS_LOGS_CREDENTIALS=
# Optional IP allowlist (comma-separated exact IPs)
# METRICS_LOGS_ALLOWLIST=127.0.0.1,::1
